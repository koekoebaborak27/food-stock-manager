// このプロジェクトのDBスキーマ。
// 列の共通ルール・命名規約は docs/specs/02_basic-design/00_共通/01_データベース共通.md と prisma/AGENTS.md のとおり。
// スキーマを変える手段はマイグレーションのみ（pnpm prisma:migrate）。db push は使わない。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 家族グループの中での役割。世帯につきADMINは1人だけ。
enum Role {
  ADMIN
  MEMBER
}

// 食品を保管する場所。画面には日本語の表示名へ変換して出す。
enum StorageType {
  REFRIGERATED
  FROZEN
  ROOM_TEMPERATURE
}

// 残数に付ける単位。未選択はStock.unitをnullにする。
enum UnitType {
  PIECE
  BAG
  PACK
  SERVING
  BOTTLE
  GOTO
}

// ログインした利用者。Googleアカウントの表示名・メールアドレス・アイコンURLを持つ。
// 退会・脱退では個人情報だけを空にし、行は残す（再ログイン時に空行を再利用する）。
model User {
  id          String   @id @default(uuid())
  googleId    String   @unique
  displayName String?
  email       String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships          Membership[]
  invitations          Invitation[]
  sessions             Session[]
  createdStocks        Stock[]           @relation("StockCreatedBy")
  updatedStocks        Stock[]           @relation("StockUpdatedBy")
  createdShoppingItems ShoppingItem[]    @relation("ShoppingItemCreatedBy")
  updatedShoppingItems ShoppingItem[]    @relation("ShoppingItemUpdatedBy")
  pushSubscription     PushSubscription?
}

// ログインのセッション。詳細は docs/specs/03_detail-design/10_認証と家族グループ/01_セッション設計.md。
// Cookieには生トークンだけを入れ、ここにはそのハッシュだけを持つ。
model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// 家族グループ。管理者は列を持たず、Membership.roleで判定する。
model Household {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships         Membership[]
  invitations         Invitation[]
  stocks              Stock[]
  shoppingItems       ShoppingItem[]
  notificationSetting NotificationSetting?
}

// 誰がどの家族グループに属しているか。1人が同時に所属できる家族グループは1つ。
model Membership {
  id          String   @id @default(uuid())
  userId      String   @unique
  householdId String
  role        Role
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

// 招待コード。参加成功・再発行・発行者の離脱で行ごと完全に消す。
model Invitation {
  id          String   @id @default(uuid())
  householdId String
  createdById String   @unique
  code        String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([householdId])
}

// 家族グループで共有する常備食。消費済・削除済も行を残して区別する。
model Stock {
  id          String      @id @default(uuid())
  householdId String
  name        String
  storageType StorageType @default(REFRIGERATED)
  quantity    Int         @default(1)
  unit        UnitType?
  expiresOn   DateTime?   @db.Date
  isHomemade  Boolean     @default(false)
  memo        String?
  consumedAt  DateTime?
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy     User?          @relation("StockCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?          @relation("StockUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  shoppingItems ShoppingItem[]

  @@index([householdId])
  @@index([householdId, deletedAt, consumedAt, expiresOn])
}

// 買い物リストの商品。常備食から追加した場合はsourceStockIdに元のStockを記録するが、
// 追加時に食品名を写しているため、常備食の名称変更や削除は商品名に影響しない。
// 同じ世帯・未購入・未削除の商品名を重複させない一意制約は、
// docs/specs/03_detail-design/30_買い物リスト/02_重複判定と一括操作の整合性.md のとおり
// マイグレーションのSQLへ手で足す部分一意索引で実現するため、ここには書けない。
model ShoppingItem {
  id            String    @id @default(uuid())
  householdId   String
  name          String
  isPurchased   Boolean   @default(false)
  sourceStockId String?
  createdById   String?
  updatedById   String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  sourceStock Stock?    @relation(fields: [sourceStockId], references: [id], onDelete: SetNull)
  createdBy   User?     @relation("ShoppingItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?     @relation("ShoppingItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([householdId, deletedAt, isPurchased, name])
}

// 通知を送る先の端末（ブラウザの購読情報）。householdIdは持たせない。配信時はUser→Membership
// をたどって世帯を判定する（docs/specs/02_basic-design/40_期限通知/01_データベース.md 1節）。
// 通知を受け取るかどうかの状態は行の有無で表し、専用の真偽値の列は持たない。
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @unique
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 家族グループ単位の通知時刻。行が存在しない世帯は8:00・未配信として扱う
// （同ドキュメント2節）。notifyMinuteが0/15/30/45のみである確認はAPI層で行う。
model NotificationSetting {
  id             String    @id @default(uuid())
  householdId    String    @unique
  notifyHour     Int       @default(8)
  notifyMinute   Int       @default(0)
  lastNotifiedOn DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}
