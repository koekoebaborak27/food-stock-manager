# 環境変数の見本。実値を書いた .env はコミットしない（.gitignore で除外済み）。
# 追加したら、この見本にもキーと説明を 1 行足すこと。

# 画面操作テスト（Playwright）の接続先。未設定なら http://localhost:3000 を使う。
E2E_BASE_URL=http://localhost:3000

# 画面操作テストで使うログイン情報（テスト用アカウント。実アカウントを書かない）。
# E2E_USER_ID=testuser
# E2E_USER_PASSWORD=

# DB接続文字列。実値は .env / .env.local 側に書く。
# ローカル開発は docker/docker-compose.yml のPostgresに合わせる。
DATABASE_URL=postgresql://app:password@localhost:5432/app_db

# Googleログイン（Google Cloud ConsoleでOAuthクライアントIDを発行して入れる）。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ログイン成功後にブラウザを戻す先（画面側のオリジン）。
WEB_BASE_URL=http://localhost:3000

# 期限通知（Web Push）で使うVAPID鍵。一度生成したら使い回す（値を変えると、
# それまでに登録された購読がすべて無効になる）。
# 生成方法: apps/apiで`pnpm install`した後、
# `node -e "console.log(require('web-push').generateVAPIDKeys())"`を実行する。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Web Pushの送信元として名乗る連絡先（mailto:のメールアドレス、または配信元のURL）。
VAPID_SUBJECT=mailto:example@example.com
# 画面（apps/web）が購読登録時に使う公開鍵。VAPID_PUBLIC_KEYと同じ値を入れる。
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
